# CALION Academy — Local Development Environment Variables
# Copy this file to .env or .env.local to configure Supabase for local testing.
# Never commit your .env or .env.local file to Git.

# Supabase Project URL (HTTPS)
CALION_SUPABASE_URL=https://your-project.supabase.co

# Supabase Public Anon Key (Never use service_role key)
CALION_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example_anon_key
